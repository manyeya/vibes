{
  "name": "harness-vibes",
  "version": "1.0.0",
  "description": "Vibes agent framework - A powerful AI agent orchestrator with multi-step reasoning, memory, and collaboration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --packages external --sourcemap=external && tsc --emitDeclarationOnly --outDir dist",
    "dev": "bun run --watch index.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@exalabs/ai-sdk": "^2.1.0",
    "@hono/zod-validator": "^0.7.6",
    "ai": "^7.0.1",
    "bash-tool": "^1.3.17",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@ai-sdk/openai": "^4.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "orchestrator",
    "postgres",
    "drizzle",
    "ai-sdk"
  ],
  "author": "",
  "license": "MIT",
  "optionalDependencies": {
    "@libsql/client": "^0.17.4",
    "postgres": "^3.4.9"
  }
}